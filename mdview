  .mermaid .mdview-svg-dl svg { fill: currentColor; display: block; }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Find pandoc-emitted mermaid code blocks and convert them to <div class="mermaid">.
    document.querySelectorAll('pre.mermaid, code.mermaid, code.language-mermaid').forEach(function (el) {
      var pre = el.tagName === 'PRE' ? el : el.closest('pre');
      if (!pre) return;
      var text = (el.textContent || pre.textContent).replace(/\n$/, '');
      var wrapper = pre.parentElement;
      var target = wrapper && wrapper.classList && wrapper.classList.contains('sourceCode') ? wrapper : pre;
      var div = document.createElement('div');
      div.className = 'mermaid';
      div.textContent = text;
      target.replaceWith(div);
    });
    if (!window.mermaid) return;
    mermaid.initialize({ startOnLoad: false, theme: 'default', securityLevel: 'loose' });

    var DOWNLOAD_SVG = '<svg aria-hidden="true" height="16" width="16" viewBox="0 0 16 16"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14Z"/><path d="M7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06Z"/></svg>';
    var CHECK_SVG_DL = '<svg aria-hidden="true" height="16" width="16" viewBox="0 0 16 16"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/></svg>';

    function decorate() {
      document.querySelectorAll('.mermaid').forEach(function (div, idx) {
        if (div.querySelector(':scope > .mdview-svg-dl')) return;
        var svg = div.querySelector(':scope > svg');
        if (!svg) return;
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'mdview-svg-dl';
        btn.title = 'Download SVG';
        btn.setAttribute('aria-label', 'Download SVG');
        btn.innerHTML = DOWNLOAD_SVG;
        btn.addEventListener('click', function () {
          var clone = svg.cloneNode(true);
          if (!clone.getAttribute('xmlns')) clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
          if (!clone.getAttribute('xmlns:xlink')) clone.setAttribute('xmlns:xlink', 'http://www.w3.org/1999/xlink');
          var xml = new XMLSerializer().serializeToString(clone);
          var blob = new Blob(['<?xml version="1.0" encoding="UTF-8"?>\n' + xml],
                              { type: 'image/svg+xml;charset=utf-8' });
          var url = URL.createObjectURL(blob);
          var a = document.createElement('a');
          a.href = url;
          a.download = 'diagram-' + (idx + 1) + '.svg';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(function () { URL.revokeObjectURL(url); }, 0);
          btn.classList.add('downloaded');
          btn.innerHTML = CHECK_SVG_DL;
          setTimeout(function () {
            btn.classList.remove('downloaded');
            btn.innerHTML = DOWNLOAD_SVG;
          }, 1500);
        });
        div.appendChild(btn);
      });
    }

    var result = mermaid.run();
    if (result && typeof result.then === 'function') {
      result.then(decorate).catch(decorate);
    } else {
      // Older mermaid versions render synchronously.
      decorate();
    }
  });
</script>
EOF

