#!/usr/bin/env bash
#
# mdview - render Markdown with GitHub-style CSS and open it in Chrome.
#
# Usage:
#   mdview [-a|--all] [-r|--root DIR] [-d|--diff] [-R|--raw] [-W|--watch]
#          [-o|--output DIR] <file.md>
#
# Options:
#   -a, --all         Also render every other .md / .markdown file found under
#                     the root directory (recursively) and rewrite *.md links
#                     so you can click between pages in the browser.
#   -r, --root DIR    Root directory for --all (defaults to the current working
#                     directory). The entry file must live inside this dir.
#   -d, --diff        Append a collapsible git diff block to the rendered page
#                     (requires the file to be tracked by git).
#   -R, --raw         Enable a "Raw" button (hotkey r) that shows the original
#                     markdown source for the current text selection. Increases
#                     rendered HTML size because pandoc annotates every element
#                     with source positions.
#   -W, --watch       Keep running and re-render whenever a watched .md file
#                     changes. Reload the page in the browser yourself to pick
#                     up changes. Ctrl-C to stop. Poll interval in seconds can
#                     be set with MDVIEW_WATCH_INTERVAL (default 1).
#   -o, --output DIR  Render into DIR instead of a temp dir, and do not open
#                     Chrome. Created if missing. Existing files are overwritten.

set -euo pipefail

ALL=false
ROOT_DIR=""
# WANT_DIFF holds the user's intent and is never reassigned. Whether a diff
# actually exists is recomputed per render pass, so --watch keeps working
# after the file gains or loses uncommitted changes.
WANT_DIFF=false
SHOW_RAW=false
WATCH=false
OUTPUT_DIR=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -a|--all) ALL=true; shift ;;
        -d|--diff) WANT_DIFF=true; shift ;;
        -R|--raw) SHOW_RAW=true; shift ;;
        -W|--watch) WATCH=true; shift ;;
        -r|--root)
            [[ $# -ge 2 ]] || { echo "Error: --root needs an argument" >&2; exit 2; }
            ROOT_DIR=$2; shift 2 ;;
        -o|--output)
            [[ $# -ge 2 ]] || { echo "Error: --output needs an argument" >&2; exit 2; }
            OUTPUT_DIR=$2; shift 2 ;;
        -h|--help)
            sed -n '3,25p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        --) shift; break ;;
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) break ;;
    esac
done

if [[ $# -ne 1 ]]; then
    sed -n 's/^#   mdview/Usage: mdview/p' "$0" | head -1 >&2
    echo "Try '$(basename "$0") -h' for more information." >&2
    exit 2
fi

MD_FILE=$1

if [[ ! -f "$MD_FILE" ]]; then
    echo "Error: file not found: $MD_FILE" >&2
    exit 1
fi

if ! command -v pandoc >/dev/null 2>&1; then
    echo "Error: pandoc is not installed." >&2
    echo "Install it with:" >&2
    echo "    brew install pandoc" >&2
    exit 1
fi

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/Library/Caches}/mdview"
mkdir -p "$CACHE_DIR"

CSS_FILE="$CACHE_DIR/github-markdown.css"
CSS_REPO="sindresorhus/github-markdown-css"

if [[ ! -f "$CSS_FILE" ]]; then
    echo "Fetching latest github-markdown-css release..." >&2
    LATEST_TAG=$(
        curl -fsSL "https://api.github.com/repos/${CSS_REPO}/releases/latest" \
            | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' \
            | head -n1
    )
    if [[ -z "${LATEST_TAG:-}" ]]; then
        echo "Error: could not determine latest release tag for ${CSS_REPO}" >&2
        exit 1
    fi
    URL="https://raw.githubusercontent.com/${CSS_REPO}/${LATEST_TAG}/github-markdown.css"
    echo "Downloading ${URL}" >&2
    curl -fsSL "$URL" -o "$CSS_FILE"
fi

MERMAID_FILE="$CACHE_DIR/mermaid.min.js"
MERMAID_REPO="mermaid-js/mermaid"

if [[ ! -f "$MERMAID_FILE" ]]; then
    echo "Fetching latest mermaid release..." >&2
    # The mermaid-js/mermaid repo is a monorepo; filter for tags starting with "mermaid@".
    MERMAID_TAG=$(
        curl -fsSL "https://api.github.com/repos/${MERMAID_REPO}/releases?per_page=50" \
            | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' \
            | grep '^mermaid@' \
            | head -n1
    )
    if [[ -z "${MERMAID_TAG:-}" ]]; then
        echo "Error: could not determine latest release tag for ${MERMAID_REPO}" >&2
        exit 1
    fi
    MERMAID_VER=${MERMAID_TAG#mermaid@}
    URL="https://cdn.jsdelivr.net/npm/mermaid@${MERMAID_VER}/dist/mermaid.min.js"
    echo "Downloading mermaid@${MERMAID_VER} from jsDelivr..." >&2
    curl -fsSL "$URL" -o "$MERMAID_FILE"
fi

# Honors $TMPDIR (i.e. /var/folders/... on macOS, auto-cleaned by the OS).
TMP_DIR=$(mktemp -d -t mdview)
trap 'rm -rf "$TMP_DIR"' EXIT

if [[ -n "$OUTPUT_DIR" ]]; then
    # Expand a leading ~ and resolve relative paths against $PWD.
    OUTPUT_DIR=${OUTPUT_DIR/#\~/$HOME}
    [[ "$OUTPUT_DIR" != /* ]] && OUTPUT_DIR="$PWD/$OUTPUT_DIR"
    mkdir -p "$OUTPUT_DIR"
    OUT_DIR=$OUTPUT_DIR
else
    OUT_DIR="$TMP_DIR/site"
    mkdir -p "$OUT_DIR"
fi
# Symlink cached assets into the site dir so pages can reference them with
# clean relative paths (e.g. "../github-markdown.css") instead of leaking
# absolute filesystem paths into the HTML source. -sfn lets us re-export
# into the same OUTPUT_DIR repeatedly without stale-symlink errors.
ln -sfn "$CSS_FILE"     "$OUT_DIR/github-markdown.css"
ln -sfn "$MERMAID_FILE" "$OUT_DIR/mermaid.min.js"

HEADER_FILE="$TMP_DIR/header.html"
BEFORE_FILE="$TMP_DIR/before.html"
AFTER_FILE="$TMP_DIR/after.html"
LUA_FILTER="$TMP_DIR/mdlinks.lua"
MERMAID_HEADER_TEMPLATE="$TMP_DIR/mermaid-header.tpl.html"

cat >"$MERMAID_HEADER_TEMPLATE" <<'EOF'
<script src="__MERMAID_SRC__"></script>
<style>
  .mermaid { position: relative; }
  .mermaid .mdview-svg-dl {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 28px;
    height: 28px;
