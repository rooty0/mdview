local srcdir = ""
if PANDOC_STATE and PANDOC_STATE.input_files and PANDOC_STATE.input_files[1] then
  local input = PANDOC_STATE.input_files[1]
  srcdir = input:match("^(.*)/[^/]+$") or ""
end

local function is_external(target)
  if target == nil or target == "" then return true end
  if target:match("^%a[%w+.-]*://") then return true end
  if target:match("^mailto:") then return true end
  if target:match("^#") then return true end
  if target:sub(1, 1) == "/" then return true end
  return false
end

local function absolutize(target)
  if srcdir == "" then return target end
  local path, suffix = target:match("^([^#?]*)(.*)$")
  if path == "" then return target end
  return srcdir .. "/" .. path .. suffix
end

local function rewrite_link(target)
  if is_external(target) then return target end
  local path, suffix = target:match("^([^#?]*)(.*)$")
  local lower = path:lower()
  if lower:sub(-3) == ".md" then
    return path:sub(1, -4) .. ".html" .. suffix
  elseif lower:sub(-9) == ".markdown" then
    return path:sub(1, -10) .. ".html" .. suffix
  end
  return absolutize(target)
end

function Link(el)
  el.target = rewrite_link(el.target)
  return el
end

function Image(el)
  if not is_external(el.src) then
    el.src = absolutize(el.src)
  end
  return el
end
LUA

# Resolve the entry file to an absolute path and pick the base directory.
MD_DIR_ABS=$(cd "$(dirname "$MD_FILE")" && pwd)
MD_FILE_ABS="$MD_DIR_ABS/$(basename "$MD_FILE")"

if $ALL; then
    if [[ -n "$ROOT_DIR" ]]; then
        [[ -d "$ROOT_DIR" ]] || { echo "Error: --root dir does not exist: $ROOT_DIR" >&2; exit 1; }
        BASE_DIR=$(cd "$ROOT_DIR" && pwd)
    else
        BASE_DIR=$(pwd)
    fi
    case "$MD_FILE_ABS/" in
        "$BASE_DIR/"*) ;;
        *)
            echo "Error: $MD_FILE is not inside the root directory: $BASE_DIR" >&2
            echo "Hint: cd into a parent directory of the file, or pass --root <dir>." >&2
            exit 1
            ;;
    esac
else
    BASE_DIR=$MD_DIR_ABS
fi

# (Re)collect the list of markdown files to render into MD_FILES. Called once
# up front, and again on every watch cycle so files added or removed under
# BASE_DIR after startup are picked up.
collect_md_files() {
    MD_FILES=()
    if $ALL; then
        while IFS= read -r -d '' f; do
            MD_FILES+=("$f")
        done < <(find "$BASE_DIR" -type f \( -iname '*.md' -o -iname '*.markdown' \) -print0)
    else
        MD_FILES=("$MD_FILE_ABS")
    fi
}
collect_md_files

# Pure-bash relative path: relpath <target> <base>  (both must be absolute)
relpath() {
    local target=$1 base=$2
    # Split into slash-separated segments via IFS
    local -a t_parts b_parts
    IFS='/' read -ra t_parts <<< "${target#/}"
    IFS='/' read -ra b_parts <<< "${base#/}"
    # Drop common leading segments
    local common=0
    while [[ $common -lt ${#t_parts[@]} && $common -lt ${#b_parts[@]} && \
             "${t_parts[$common]}" == "${b_parts[$common]}" ]]; do
        (( common++ )) || true
    done
    # One ".." for every remaining base segment
    local rel=""
    local i
    for (( i=common; i<${#b_parts[@]}; i++ )); do
        rel="${rel:+$rel/}.."
    done
    # Append remaining target segments
    for (( i=common; i<${#t_parts[@]}; i++ )); do
        rel="${rel:+$rel/}${t_parts[$i]}"
    done
    echo "${rel:-.}"
}

# gfm turns on tex_math_dollars, which reads two "$" amounts in one
# paragraph as inline-math delimiters and swallows everything between them
# — bold, code spans and all — into a math span. Prose about money is far
# more common here than TeX, and nothing renders math anyway (no MathJax or
# KaTeX is loaded), so both math extensions are off: ```math fences come out
# as ordinary code blocks, which at least stay readable and copyable.
PANDOC_FROM="gfm-tex_math_dollars-tex_math_gfm"

render_md() {
    local src=$1 dst=$2 with_diff=${3:-false}
    local dst_dir
    dst_dir=$(dirname "$dst")
    mkdir -p "$dst_dir"

    # Compute relative paths so the page references symlinked assets cleanly.
    local css_rel
    css_rel=$(relpath "$OUT_DIR/github-markdown.css" "$dst_dir")

    # Always apply the Lua filter: it rewrites *.md links to *.html and turns
    # relative image/asset paths into absolute paths that point back at the
    # source tree (so <img src="docs/foo.png"> resolves from OUT_DIR). The
    # filter derives the source dir from PANDOC_STATE.input_files, so $src
    # must be an absolute path when passed to pandoc (it always is here).
    local filter_args=(--lua-filter="$LUA_FILTER")

    local header_files=(-H "$HEADER_FILE")
    # Pull in mermaid only for files that actually contain a mermaid fence.
    # Use a per-render header file so parallel jobs don't race on writing it.
    local mermaid_header=""
    if grep -qE '^[[:space:]]*```mermaid([[:space:]]|$)' "$src"; then
        local mermaid_rel
        mermaid_rel=$(relpath "$OUT_DIR/mermaid.min.js" "$dst_dir")
        # Note: BSD mktemp only substitutes *trailing* Xs, so the template
        # must not carry a suffix after them. Pandoc reads -H/-A includes
        # verbatim and ignores the extension.
        mermaid_header=$(mktemp "$TMP_DIR/mermaid-header.XXXXXXXX")
        sed "s|__MERMAID_SRC__|$mermaid_rel|g" "$MERMAID_HEADER_TEMPLATE" >"$mermaid_header"
        header_files+=(-H "$mermaid_header")
    fi

    local after_files=(-A "$AFTER_FILE")
    if [[ "$with_diff" == "true" ]]; then
        after_files+=(-A "$DIFF_SUFFIX_FILE")
    fi

    # --raw: enable sourcepos so every element carries data-pos, and embed the
    # raw markdown so JS can slice it on demand. Per-file after-file so each
    # page gets its own source.
    local from_fmt="$PANDOC_FROM"
    local raw_after=""
    if $SHOW_RAW; then
        from_fmt="$PANDOC_FROM+sourcepos"
        raw_after=$(mktemp "$TMP_DIR/raw-suffix.XXXXXXXX")
        {
            printf '<script type="text/markdown" id="mdview-source">'
            # Escape </script> (case-insensitive) so the raw source cannot
            # accidentally close the containing <script> tag. Also escape any
            # standalone < that could start a tag inside a script of type
            # text/markdown; the spec is lenient here but <\/script> is the
            # only sequence that matters.
            sed 's|</\([sS][cC][rR][iI][pP][tT]\)|<\\/\1|g' "$src"
            printf '</script>'
        } >"$raw_after"
        after_files+=(-A "$raw_after")
    fi

    pandoc \
        --from="$from_fmt" \
        --to=html5 \
        --standalone \
        --metadata title="$(basename "$src")" \
        --css="$css_rel" \
        "${filter_args[@]}" \
        "${header_files[@]}" \
        -B "$BEFORE_FILE" \
        "${after_files[@]}" \
        -o "$dst" \
        "$src"

    # These are per-invocation scratch files; drop them so a long --watch
    # session doesn't accumulate one pair per file per cycle in TMP_DIR.
    [[ -n "$mermaid_header" ]] && rm -f "$mermaid_header"
    [[ -n "$raw_after" ]] && rm -f "$raw_after"
    return 0
}

DIFF_SUFFIX_FILE="$TMP_DIR/diff-suffix.html"

# Rebuild the diff suffix file from the working tree's current state and echo
# "true" if a diff was produced. Recomputed on every pass so --watch reflects
# changes that appear or disappear (e.g. after a commit) mid-session. Never
# touches WANT_DIFF, which is the user's --diff intent.
build_diff_suffix() {
    printf '' >"$DIFF_SUFFIX_FILE"
    $WANT_DIFF || { echo false; return 0; }

    if ! git -C "$MD_DIR_ABS" rev-parse --git-dir >/dev/null 2>&1; then
        echo false
        return 0
    fi

    local diff_output
    diff_output=$(git -C "$MD_DIR_ABS" diff HEAD -- "$(basename "$MD_FILE_ABS")" 2>/dev/null || true)
    if [[ -z "$diff_output" ]]; then
        echo false
        return 0
    fi

    # The diff may contain its own ```fenced``` blocks. Pick a fence length
    # one longer than the longest backtick run inside the diff so it can't
    # be accidentally closed by content.
    local max_ticks fence_len fence diff_html
    max_ticks=$(printf '%s' "$diff_output" | awk '
        { run = 0; max = 0
          for (i = 1; i <= length($0); i++) {
              if (substr($0, i, 1) == "`") { run++; if (run > max) max = run }
              else run = 0
          }
          if (max > G) G = max
        }
        END { print G + 0 }')
    fence_len=$(( max_ticks > 2 ? max_ticks + 1 : 3 ))
    fence=$(printf "%${fence_len}s" "" | tr ' ' '`')
    # Render the diff through pandoc so Skylighting colours the +/- lines.
    diff_html=$(printf '%sdiff\n%s\n%s\n' "$fence" "$diff_output" "$fence" \
        | pandoc --from="$PANDOC_FROM" --to=html5 2>/dev/null)
    cat >"$DIFF_SUFFIX_FILE" <<EOF
<div id="mdview-diff-modal-content" style="display:none;">$diff_html</div>
EOF
    echo true
}

# Warn about an unusable --diff exactly once, not on every watch cycle.
if $WANT_DIFF && ! git -C "$MD_DIR_ABS" rev-parse --git-dir >/dev/null 2>&1; then
    echo "Warning: --diff ignored, $MD_FILE is not inside a git repository." >&2
    WANT_DIFF=false
fi

# Render the given files (defaults to all of MD_FILES) in parallel with a
# fixed-size worker pool (override with MDVIEW_JOBS).
render_all() {
    local -a targets=("$@")
    (( ${#targets[@]} )) || targets=("${MD_FILES[@]}")

    local has_diff
    has_diff=$(build_diff_suffix)

    local jobs=${MDVIEW_JOBS:-4}
    (( jobs < 1 )) && jobs=1
    local running=0 src rel dst
    for src in "${targets[@]}"; do
        rel=$(relpath "$src" "$BASE_DIR")
        dst="$OUT_DIR/${rel%.*}.html"
        # Only attach the diff to the entry file.
        if [[ "$has_diff" == "true" && "$src" == "$MD_FILE_ABS" ]]; then
            render_md "$src" "$dst" true &
        else
            render_md "$src" "$dst" &
        fi
        if (( ++running >= jobs )); then
            wait -n
            (( running-- ))
        fi
    done
    wait
}

if $ALL; then
    echo "Rendering ${#MD_FILES[@]} markdown file(s) under $BASE_DIR ..." >&2
fi
render_all

ENTRY_REL=$(relpath "$MD_FILE_ABS" "$BASE_DIR")
ENTRY_HTML="$OUT_DIR/${ENTRY_REL%.*}.html"

if [[ -n "$OUTPUT_DIR" ]]; then
    echo "Wrote ${#MD_FILES[@]} file(s) to $OUT_DIR" >&2
    echo "Entry: $ENTRY_HTML" >&2
else
    open -a "Google Chrome" "$ENTRY_HTML"
    if ! $WATCH; then
        # Keep the temp dir alive so Chrome can keep reading & navigating
        # between pages after we exit.
        trap - EXIT
    fi
fi

$WATCH || exit 0

# --- watch mode -------------------------------------------------------------
# Poll mtimes rather than depending on fswatch/entr. Re-globbing each cycle
# also picks up files created or deleted under BASE_DIR after startup.

# Exit quietly on Ctrl-C; the EXIT trap still fires and clears TMP_DIR.
trap 'echo >&2; exit 0' INT TERM

INTERVAL=${MDVIEW_WATCH_INTERVAL:-1}

# Print "<path>\t<mtime>" for every currently watched file.
snapshot() {
    local f
    for f in "${MD_FILES[@]}"; do
        printf '%s\t%s\n' "$f" "$(stat -f %m "$f" 2>/dev/null || echo missing)"
    done
}

# Fingerprint of the entry file's git diff. `git commit` changes the diff
# without touching any mtime, so the diff needs watching in its own right or
# the embedded Diff modal goes stale.
diff_fingerprint() {
    $WANT_DIFF || return 0
    git -C "$MD_DIR_ABS" diff HEAD -- "$(basename "$MD_FILE_ABS")" 2>/dev/null | md5
}

PREV_SNAPSHOT=$(snapshot)
PREV_DIFF_FP=$(diff_fingerprint)

if [[ -z "$OUTPUT_DIR" ]]; then
    echo "Watching for changes (reload the page in Chrome to see updates). Ctrl-C to stop." >&2
else
    echo "Watching for changes. Ctrl-C to stop." >&2
fi

while true; do
    sleep "$INTERVAL"

    collect_md_files
    CUR_SNAPSHOT=$(snapshot)
    CUR_DIFF_FP=$(diff_fingerprint)

    # Re-render only the files whose mtime line changed or that are new.
    CHANGED=()
    if [[ "$CUR_SNAPSHOT" != "$PREV_SNAPSHOT" ]]; then
        while IFS=$'\t' read -r path _; do
            [[ -n "$path" && -f "$path" ]] && CHANGED+=("$path")
        done < <(comm -13 <(printf '%s\n' "$PREV_SNAPSHOT" | sort) \
                         <(printf '%s\n' "$CUR_SNAPSHOT" | sort))
    fi

    # A changed diff only affects the entry page, which is where it's embedded.
    if [[ "$CUR_DIFF_FP" != "$PREV_DIFF_FP" && " ${CHANGED[*]} " != *" $MD_FILE_ABS "* ]]; then
        CHANGED+=("$MD_FILE_ABS")
    fi

    PREV_SNAPSHOT=$CUR_SNAPSHOT
    PREV_DIFF_FP=$CUR_DIFF_FP
    (( ${#CHANGED[@]} )) || continue

    render_all "${CHANGED[@]}"
    printf '[%s] re-rendered %d file(s): %s\n' \
        "$(date +%H:%M:%S)" "${#CHANGED[@]}" \
        "$(printf '%s ' "${CHANGED[@]##*/}")" >&2
done
