# EditorConfig is awesome: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

# indent_size is deliberately unset for the main script: the Bash body is
# 4-space indented while the HTML/CSS/JS inside its heredocs is 2-space.

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.lua]
indent_size = 2
